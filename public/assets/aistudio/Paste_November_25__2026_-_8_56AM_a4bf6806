        const taskNameInput = document.getElementById('task-name-input');
        const deadlineDateInput = document.getElementById('deadline-date-input');
        const deadlineTimeInput = document.getElementById('deadline-time-input');
        const addModalError = document.getElementById('add-modal-error');
        const addModalErrorText = document.getElementById('add-modal-error-text');

        // Confirm Modal Elements
        const confirmModal = document.getElementById('confirm-modal');
        const confirmIconWrap = document.getElementById('confirm-icon-wrap');
        const confirmTitle = document.getElementById('confirm-title');
        const confirmMessage = document.getElementById('confirm-message');
        const confirmCancelBtn = document.getElementById('confirm-cancel-btn');
        const confirmProceedBtn = document.getElementById('confirm-proceed-btn');

        // Settings & Auth Elements
        const settingsMenuContainer = document.getElementById('settings-menu-container');
        const settingsGearBtn = document.getElementById('settings-gear-btn');
        const settingsDropdown = document.getElementById('settings-dropdown');
        const userAvatarBadge = document.getElementById('user-avatar-badge');
        const userDisplayName = document.getElementById('user-display-name');
        const userDisplayEmail = document.getElementById('user-display-email');
        const userRolePill = document.getElementById('user-role-pill');
        const adminWhitelistSection = document.getElementById('admin-whitelist-section');
        const toggleAddUserBtn = document.getElementById('toggle-add-user-btn');
        const toggleClearDataBtn = document.getElementById('toggle-clear-data-btn');
        const logoutBtn = document.getElementById('logout-btn');
        const floatingRoleSwitcher = document.getElementById('floating-role-switcher');
        const floatingAdminViewBtn = document.getElementById('floating-admin-view-btn');
        const floatingUserViewBtn = document.getElementById('floating-user-view-btn');

        // Login & Google Chooser Elements
        const loggedOutScreen = document.getElementById('logged-out-screen');
        const googleSigninBtn = document.getElementById('google-signin-btn');
        const loginErrorMsg = document.getElementById('login-error-msg');
        const googleChooserModal = document.getElementById('google-chooser-modal');
        const closeChooserBtn = document.getElementById('close-chooser-btn');
        const chooserAccountList = document.getElementById('chooser-account-list');
        const customGoogleEmailForm = document.getElementById('custom-google-email-form');
        const googleEmailVerifyInput = document.getElementById('google-email-verify-input');

        let allowedUsers = [{ email: HARDCODED_ADMIN_EMAIL, name: 'Director' }];
        let userProfile = null;
        let previewRole = 'admin';

        function isAdminEmail(email) {
            return (email || '').trim().toLowerCase() === HARDCODED_ADMIN_EMAIL;
        }

        // =========================================================================
        // FIRESTORE REAL-TIME LISTENERS & CLOUD SYNC HELPERS
        // =========================================================================
        function canUseFirestore() {
            return Boolean(db && auth && auth.currentUser);
        }

        function startFirestoreSync() {
            if (!canUseFirestore()) return;

            if (unsubscribeUsers) unsubscribeUsers();
            unsubscribeUsers = onSnapshot(
                collection(db, 'authorized_users'),
                (snapshot) => {
                    const map = new Map();
                    map.set(HARDCODED_ADMIN_EMAIL, {
                        email: HARDCODED_ADMIN_EMAIL,
                        name: 'Director'
                    });
                    snapshot.forEach((docSnap) => {
                        const data = docSnap.data() || {};
                        const email = (data.email || docSnap.id || '').trim().toLowerCase();
                        if (email) {
                            map.set(email, {
                                email,
                                name: capitalizeFirst(String(data.name || deriveNameFromEmail(email)).trim())
                            });
                        }
                    });
                    allowedUsers = Array.from(map.values());
                    saveAllowedUsersLocal();
                    if (state.rightPanelMode === 'addUser') {
                        renderAddUserRightPanel();
                    }
                },
                (err) => {
                    console.error('Firestore authorized_users listener error:', err);
                }
            );

            if (unsubscribeTasklets) unsubscribeTasklets();
            unsubscribeTasklets = onSnapshot(
                collection(db, 'tasklets'),
                (snapshot) => {
                    const cloudTasklets = [];
                    snapshot.forEach((docSnap) => {
                        cloudTasklets.push({
                            id: docSnap.id,
                            ...docSnap.data()
                        });
                    });
                    state.tasklets = cloudTasklets;
                    saveToLocalStorage();
                    if (!state.selectedId && state.tasklets.length > 0) {
                        const sorted = getFilteredTasklets();
                        state.selectedId = sorted.length > 0 ? sorted[0].id : state.tasklets[0].id;
                    }
                    // Preserve focus & active typing in the description textarea during Firestore snapshot updates
                    const activeEl = document.activeElement;
                    if (activeEl && activeEl.id === 'detail-description-input') {
                        renderFilterTabs();
                        renderTaskletList();
                    } else {
                        renderAll();
                    }
                },
                (err) => {
                    console.error('Firestore tasklets listener error:', err);
                }
            );
        }

        function stopFirestoreSync() {
            if (unsubscribeTasklets) {
                unsubscribeTasklets();
                unsubscribeTasklets = null;
            }
            if (unsubscribeUsers) {
                unsubscribeUsers();
                unsubscribeUsers = null;
            }
        }

        async function syncTaskletToCloud(tasklet) {
            saveToLocalStorage();
            if (!canUseFirestore() || !tasklet || !tasklet.id) return;
            try {
                await setDoc(doc(db, 'tasklets', tasklet.id), tasklet, { merge: true });
            } catch (err) {
                console.error('Failed to sync tasklet to Firestore:', err);
                showToast('Cloud sync failed. Saved locally.', 'error');
            }
        }

        async function syncAuthorizedUserToCloud(userObj) {
            saveAllowedUsersLocal();
            if (!canUseFirestore() || !userObj || !userObj.email) return;
            try {
                await setDoc(doc(db, 'authorized_users', userObj.email), userObj, { merge: true });
            } catch (err) {
                console.error('Failed to add authorized user in Firestore:', err);
                showToast('Cloud user sync failed.', 'error');
            }
        }

        async function removeAuthorizedUserFromCloud(email) {
            saveAllowedUsersLocal();
            if (!canUseFirestore() || !email || isAdminEmail(email)) return;
            try {
                await deleteDoc(doc(db, 'authorized_users', email));
            } catch (err) {
                console.error('Failed to remove authorized user from Firestore:', err);
                showToast('Cloud user removal failed.', 'error');
            }
        }

        // =========================================================================
        // USER ALLOWLIST & SESSION MANAGEMENT (7-DAY PERSISTENCE)
        // =========================================================================
        function loadAllowedUsers() {
            try {
                const raw = localStorage.getItem(ALLOWED_USERS_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    if (Array.isArray(parsed)) {
                        const normalizedMap = new Map();
                        parsed.forEach((entry) => {
                            if (typeof entry === 'string') {
                                const cleanEmail = entry.trim().toLowerCase();
                                if (cleanEmail) {
                                    normalizedMap.set(cleanEmail, {
                                        email: cleanEmail,
                                        name: deriveNameFromEmail(cleanEmail)
                                    });
                                }
                            } else if (entry && typeof entry === 'object' && entry.email) {
                                const cleanEmail = String(entry.email).trim().toLowerCase();
                                if (cleanEmail) {
                                    normalizedMap.set(cleanEmail, {
                                        email: cleanEmail,
                                        name: capitalizeFirst(String(entry.name || deriveNameFromEmail(cleanEmail)).trim())
                                    });
                                }
                            }
                        });
                        normalizedMap.set(HARDCODED_ADMIN_EMAIL, {
                            email: HARDCODED_ADMIN_EMAIL,
                            name: 'Director'
                        });
                        allowedUsers = Array.from(normalizedMap.values());
                        return;
                    }
                }
            } catch (err) {
                console.error('Failed to load allowed users:', err);
            }
            allowedUsers = [{ email: HARDCODED_ADMIN_EMAIL, name: 'Director' }];
            saveAllowedUsersLocal();
        }

        function saveAllowedUsersLocal() {
            if (!allowedUsers.some((u) => isAdminEmail(u.email))) {
                allowedUsers.unshift({ email: HARDCODED_ADMIN_EMAIL, name: 'Director' });
            }
            try {
                localStorage.setItem(ALLOWED_USERS_KEY, JSON.stringify(allowedUsers));
            } catch (err) {
                console.error('Failed to save allowed users:', err);
            }
        }

        function deriveNameFromEmail(email) {
            if (isAdminEmail(email)) return 'Director';
            const existing = allowedUsers.find((u) => u.email === (email || '').trim().toLowerCase());
            if (existing && existing.name) return existing.name;
            const localPart = (email || '').split('@')[0] || 'Member';
            return localPart
                .split(/[._-]+/)
                .filter(Boolean)
                .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
                .join(' ');
        }

        function saveSession() {
            try {
                if (userProfile) {
                    const sessionPayload = {
                        ...userProfile,
                        expiresAt: Date.now() + SEVEN_DAYS_MS
                    };
                    localStorage.setItem(SESSION_KEY, JSON.stringify(sessionPayload));
                } else {
                    localStorage.removeItem(SESSION_KEY);
                }
            } catch (err) {
                console.error('Failed to persist session:', err);
            }
        }

        function loadSession() {
            try {
                const raw = localStorage.getItem(SESSION_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    if (parsed && parsed.email) {
                        if (parsed.expiresAt && Date.now() > parsed.expiresAt) {
                            localStorage.removeItem(SESSION_KEY);
                            userProfile = null;
                            return;
                        }
                        const cleanEmail = parsed.email.trim().toLowerCase();
                        const matchedUser = allowedUsers.find((u) => u.email === cleanEmail);
                        if (matchedUser) {
                            userProfile = {
                                name: parsed.name || matchedUser.name || deriveNameFromEmail(cleanEmail),
                                email: cleanEmail,
                                photoURL: parsed.photoURL || ''
                            };
                            previewRole = isAdminEmail(cleanEmail) ? 'admin' : 'user';
                            return;
                        }
                    }
                }
            } catch (err) {
                console.error('Failed to load session:', err);
            }
            // Default to signed-in Admin only in sandboxed design preview; enforce real Google Sign-In on GitHub Pages / live hosting
            if (isPreviewSandbox) {
                userProfile = {
                    name: 'Director',
                    email: HARDCODED_ADMIN_EMAIL,
                    photoURL: ''
                };
                previewRole = 'admin';
                saveSession();
            } else {
                userProfile = null;
            }
        }

        function updateUserProfileUI() {
            if (!userProfile) {
                loggedOutScreen.classList.remove('hidden');
                floatingRoleSwitcher.classList.add('hidden');
                return;
            }

            loggedOutScreen.classList.add('hidden');
            // Show floating role switcher only in design preview; keep hidden on GitHub Pages / live site
            floatingRoleSwitcher.classList.toggle('hidden', !isPreviewSandbox);

            const showAdminUI = isPreviewSandbox
                ? previewRole === 'admin'
                : isAdminEmail(userProfile.email);
            const displayName = userProfile.name || deriveNameFromEmail(userProfile.email);
            const initial = displayName.charAt(0).toUpperCase() || 'D';
            const livePhotoURL = userProfile.photoURL || (auth && auth.currentUser && auth.currentUser.photoURL) || '';

            if (livePhotoURL) {
                userAvatarBadge.innerHTML = `<img src="${escapeHTML(livePhotoURL)}" alt="${escapeHTML(displayName)}" referrerpolicy="no-referrer" class="w-full h-full object-cover rounded-full" onerror="this.parentElement.textContent='${escapeHTML(initial)}'">`;
            } else {
                userAvatarBadge.textContent = initial;
            }
            userDisplayName.textContent = displayName;
            userDisplayEmail.textContent = userProfile.email;

            if (showAdminUI) {
                userRolePill.textContent = 'Admin';
                userRolePill.className = 'text-xs font-normal text-slate-500 mt-1';
                floatingAdminViewBtn.className = 'px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-emerald-600 text-white shadow-xs';
                floatingUserViewBtn.className = 'px-3 py-1.5 rounded-xl text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800';
            } else {
                userRolePill.textContent = 'User';
                userRolePill.className = 'text-xs font-normal text-slate-500 mt-1';
                floatingUserViewBtn.className = 'px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-emerald-600 text-white shadow-xs';
                floatingAdminViewBtn.className = 'px-3 py-1.5 rounded-xl text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800';
            }

            adminWhitelistSection.classList.toggle('hidden', !showAdminUI);
            if (!showAdminUI && (state.rightPanelMode === 'addUser' || state.rightPanelMode === 'clearData')) {
                state.rightPanelMode = 'tasklet';
            }
        }

        function switchPreviewRole(role) {
            previewRole = role;
            if (role === 'admin') {
                userProfile = {
                    name: 'Director',
                    email: HARDCODED_ADMIN_EMAIL
                };
            } else {
                const consultant = allowedUsers.find((u) => !isAdminEmail(u.email));
                userProfile = consultant
                    ? { name: consultant.name, email: consultant.email }
                    : { name: 'Consultant Member', email: 'consultant@spmniwas.in' };
            }
            saveSession();
            updateUserProfileUI();
            renderAll();
        }

        async function attemptGoogleLogin(emailInput, customDisplayName, customPhotoURL) {
            const normalizedEmail = (emailInput || '').trim().toLowerCase();
            loginErrorMsg.classList.add('hidden');

            if (!normalizedEmail) {
                return;
            }

            let authorizedEntry = allowedUsers.find((u) => u.email === normalizedEmail);

            // On a new device/browser, verify directly against Firestore authorized_users collection
            if (!authorizedEntry && !isAdminEmail(normalizedEmail) && canUseFirestore()) {
                try {
                    const userDocSnap = await getDoc(doc(db, 'authorized_users', normalizedEmail));
                    if (userDocSnap.exists()) {
                        const data = userDocSnap.data() || {};
                        authorizedEntry = {
                            email: normalizedEmail,
                            name: capitalizeFirst(String(data.name || deriveNameFromEmail(normalizedEmail)).trim())
                        };
                        allowedUsers.push(authorizedEntry);
                        saveAllowedUsersLocal();
                    }
                } catch (err) {
                    console.warn('Firestore authorization lookup:', err);
                }
            }

            if (!authorizedEntry && !isAdminEmail(normalizedEmail)) {
                googleChooserModal.classList.add('hidden');
                loginErrorMsg.textContent = `Access denied for ${normalizedEmail}. Only accounts added by ${HARDCODED_ADMIN_EMAIL} can sign in.`;
                loginErrorMsg.classList.remove('hidden');
                if (auth && auth.currentUser) {
                    signOut(auth).catch(() => {});
                }
                return;
            }

            const resolvedPhotoURL = customPhotoURL || (auth && auth.currentUser && auth.currentUser.photoURL) || (userProfile && userProfile.email === normalizedEmail ? userProfile.photoURL : '') || '';

            userProfile = {
                name: customDisplayName || (authorizedEntry && authorizedEntry.name) || deriveNameFromEmail(normalizedEmail),
                email: normalizedEmail,
                photoURL: resolvedPhotoURL
            };
            previewRole = isAdminEmail(normalizedEmail) ? 'admin' : 'user';
            saveSession();
            googleChooserModal.classList.add('hidden');
            updateUserProfileUI();
            startFirestoreSync();
            showToast(`Signed in as ${userProfile.email}`);
        }

        async function triggerFirebaseGoogleSignIn() {
            if (!auth || !googleProvider) {
                openGoogleAccountChooser();
                return;
            }
            loginErrorMsg.classList.add('hidden');
            try {
                const result = await signInWithPopup(auth, googleProvider);
                const fbUser = result.user;
                if (fbUser && fbUser.email) {
                    attemptGoogleLogin(fbUser.email, fbUser.displayName || '', fbUser.photoURL || '');
                }
            } catch (err) {
                console.error('Google Sign-In error:', err);
                loginErrorMsg.textContent = err.message || 'Google Sign-In was cancelled or failed.';
                loginErrorMsg.classList.remove('hidden');
            }
        }

        function openGoogleAccountChooser() {
            loginErrorMsg.classList.add('hidden');
            googleEmailVerifyInput.value = '';
            chooserAccountList.innerHTML = allowedUsers
                .map((userObj) => {
                    const email = userObj.email;
                    const displayName = userObj.name || deriveNameFromEmail(email);
                    const admin = isAdminEmail(email);
                    return `
                        <button
                            type="button"
                            data-choose-email="${escapeHTML(email)}"
                            class="w-full flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 border border-slate-200/80 text-left transition"
                        >
                            <div class="w-8 h-8 rounded-full bg-emerald-600 text-white text-xs font-bold flex items-center justify-center shrink-0">
                                ${escapeHTML(displayName.charAt(0).toUpperCase())}
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-1.5">
                                    <p class="text-xs font-bold text-slate-900 truncate">${escapeHTML(displayName)}</p>
                                    ${admin ? '<span class="px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-700 text-[9px] font-bold uppercase">Admin</span>' : ''}
                                </div>
                                <p class="text-[11px] text-slate-500 truncate">${escapeHTML(email)}</p>
                            </div>
                        </button>
                    `;
                })
                .join('');

            chooserAccountList.querySelectorAll('button[data-choose-email]').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const chosenEmail = btn.getAttribute('data-choose-email');
                    attemptGoogleLogin(chosenEmail);
                });
            });

            googleChooserModal.classList.remove('hidden');
        }

        settingsGearBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            settingsDropdown.classList.toggle('hidden');
        });

        document.addEventListener('click', (e) => {
            if (settingsMenuContainer && !settingsMenuContainer.contains(e.target)) {
                settingsDropdown.classList.add('hidden');
            }
        });

        toggleAddUserBtn.addEventListener('click', () => {
            const isAdmin = isPreviewSandbox
                ? previewRole === 'admin'
                : (userProfile && isAdminEmail(userProfile.email));
            if (!userProfile || !isAdmin) return;
            settingsDropdown.classList.add('hidden');
            state.rightPanelMode = 'addUser';
            state.mobileView = 'detail';
            syncMobilePaneVisibility();
            renderDetailPane();
            setTimeout(() => {
                const nameInput = document.getElementById('right-pane-user-name-input');
                if (nameInput) nameInput.focus();
            }, 40);
        });

        toggleClearDataBtn.addEventListener('click', () => {
            const isAdmin = isPreviewSandbox
                ? previewRole === 'admin'
                : (userProfile && isAdminEmail(userProfile.email));
            if (!userProfile || !isAdmin) return;
            settingsDropdown.classList.add('hidden');
