                    }
                }

                descInput.addEventListener('input', () => {
                    const capped = enforceWordLimit(descInput.value, MAX_WORDS);
                    if (capped !== descInput.value) {
                        descInput.value = capped;
                    }
                    const count = countWords(capped);
                    wordCounterEl.textContent = `${count} / ${MAX_WORDS} words`;
                    wordCounterEl.className = `font-semibold ${count >= MAX_WORDS ? 'text-amber-600' : 'text-slate-600'}`;

                    if (count >= MIN_WORDS && state.showInlineWarning) {
                        state.showInlineWarning = false;
                        inlineWarningEl.classList.add('hidden');
                        inlineWarningEl.classList.remove('flex');
                        descInput.classList.remove('border-rose-400', 'ring-2', 'ring-rose-500/20');
                        descInput.classList.add('border-slate-200');
                    }

                    autosaveStatusEl.textContent = 'Saving...';
                    autosaveStatusEl.className = 'text-slate-400 font-medium';

                    clearTimeout(saveDebounceTimer);
                    saveDebounceTimer = setTimeout(() => {
                        commitDescription(capped);
                    }, 450);
                });

                descInput.addEventListener('blur', () => {
                    clearTimeout(saveDebounceTimer);
                    const capped = enforceWordLimit(descInput.value, MAX_WORDS);
                    descInput.value = capped;
                    commitDescription(capped);
                });

                // Wire Abandoned & Close buttons
                function attemptTransition(targetStatus) {
                    clearTimeout(saveDebounceTimer);
                    const latestDesc = enforceWordLimit(descInput.value, MAX_WORDS);
                    commitDescription(latestDesc);

                    if (countWords(latestDesc) < MIN_WORDS) {
                        state.showInlineWarning = true;
                        inlineWarningEl.classList.remove('hidden');
                        inlineWarningEl.classList.add('flex');
                        descInput.classList.remove('border-slate-200');
                        descInput.classList.add('border-rose-400', 'ring-2', 'ring-rose-500/20');
                        descInput.focus();
                        return;
                    }

                    const isAbandon = targetStatus === 'Abandoned';
                    openConfirmDialog({
                        title: isAbandon ? 'Mark Tasklet as Abandoned?' : 'Close Tasklet?',
                        message: isAbandon
                            ? `Are you sure you want to mark "#${tasklet.seq} ${tasklet.title}" as Abandoned? This action locks the description.`
                            : `Are you sure you want to close "#${tasklet.seq} ${tasklet.title}"? This action locks the description.`,
                        confirmLabel: isAbandon ? 'Yes, Abandon' : 'Yes, Close',
                        variant: isAbandon ? 'danger' : 'primary',
                        onConfirm: () => {
                            tasklet.status = targetStatus;
                            tasklet.resolvedAtISO = new Date().toISOString();
                            state.showInlineWarning = false;
                            state.mobileView = 'list';
                            syncTaskletToCloud(tasklet);
                            renderAll();
                            showToast(
                                isAbandon
                                    ? `Tasklet #${tasklet.seq} abandoned.`
                                    : `Tasklet #${tasklet.seq} closed.`,
                                isAbandon ? 'abandoned' : 'closed'
                            );
                        }
                    });
                }

                document.getElementById('abandon-tasklet-btn').addEventListener('click', () => {
                    attemptTransition('Abandoned');
                });

                document.getElementById('close-tasklet-btn').addEventListener('click', () => {
                    attemptTransition('Closed');
                });
            } else {
                // Read-only view for Closed or Abandoned tasklets
                const isClosed = tasklet.status === 'Closed';
                const resolvedDate = formatDateDDMMYY(tasklet.resolvedAtISO || tasklet.deadlineISO);

                detailPaneEl.innerHTML = `
                    <div class="flex-1 flex flex-col justify-between space-y-5 sm:space-y-6">
                        <div class="space-y-4 sm:space-y-5">
                            <!-- Mobile Back Navigation Bar -->
                            <div class="lg:hidden pb-2 border-b border-slate-100 flex items-center justify-between">
                                <button
                                    id="mobile-back-readonly-btn"
                                    type="button"
                                    class="inline-flex items-center gap-1.5 px-3 py-2 -ml-1 rounded-xl text-xs font-semibold text-slate-700 hover:bg-slate-100 active:bg-slate-200/70 transition"
                                >
                                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
                                    </svg>
                                    <span>Back to List</span>
                                </button>
                                <span class="text-[11px] font-medium text-slate-400">${state.activeFilter}</span>
                            </div>

                            <!-- Top Meta Header -->
                            <div class="flex flex-wrap items-center justify-between gap-2 pb-3.5 sm:pb-4 border-b border-slate-100">
                                <div class="flex items-center gap-2">
                                    <span class="px-2.5 py-1 rounded-xl bg-slate-900 text-white text-xs font-bold">
                                        #${tasklet.seq}
                                    </span>
                                    <span class="px-3 py-1 rounded-xl text-xs font-bold ${
                                        isClosed
                                            ? 'bg-emerald-100 text-emerald-800'
                                            : 'bg-amber-100 text-amber-800'
                                    }">
                                        ${isClosed ? `Closed on ${resolvedDate}` : `Abandoned on ${resolvedDate}`}
                                    </span>
                                </div>
                                <div class="text-xs font-medium text-slate-500 flex items-center gap-1.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    <span>Original Deadline: ${formatDeadline(tasklet.deadlineISO)}</span>
                                </div>
                            </div>

                            <!-- Title -->
                            <div class="pb-1 sm:pb-3">
                                <h2 class="text-lg sm:text-xl font-bold text-slate-900 leading-snug text-left">
                                    ${escapeHTML(tasklet.title)}
                                </h2>
                            </div>

                            <!-- Read-Only Description Box -->
                            <div class="space-y-2">
                                <span class="block text-xs font-medium uppercase tracking-wider text-slate-400 text-left">
                                    Final Recorded Description (Read-Only)
                                </span>
                                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 text-sm text-slate-700 leading-relaxed text-left whitespace-pre-line">${escapeHTML((tasklet.description || 'No description provided.').trim())}</div>
                                <p class="text-xs text-slate-500 text-left pt-0.5">
                                    Created by <span class="font-semibold text-slate-700">${escapeHTML(tasklet.createdBy || (userProfile && userProfile.name) || 'NIWAS Member')}</span> on <span class="font-medium text-slate-600">${formatDeadline(tasklet.createdAtISO)}</span>
                                </p>
                            </div>
                        </div>

                        <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                            <span>This tasklet is archived and locked from further edits.</span>
                            <span class="font-semibold text-slate-500">${countWords(tasklet.description)} words</span>
                        </div>
                    </div>
                `;

                const mobileBackReadonlyBtn = document.getElementById('mobile-back-readonly-btn');
                if (mobileBackReadonlyBtn) {
                    mobileBackReadonlyBtn.addEventListener('click', () => {
                        state.mobileView = 'list';
                        syncMobilePaneVisibility();
                    });
                }
            }
        }

        function renderAll() {
            syncMobilePaneVisibility();
            renderFilterTabs();
            renderTaskletList();
            renderDetailPane();
        }

        // =========================================================================
        // ADD TASKLET MODAL & VALIDATION
        // =========================================================================
        function openAddModal() {
            addTaskletForm.reset();
            addModalError.classList.add('hidden');

            // Default date to today (YYYY-MM-DD) for convenience
            const now = new Date();
            const yyyy = now.getFullYear();
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            deadlineDateInput.min = `${yyyy}-${mm}-${dd}`;
            deadlineDateInput.value = `${yyyy}-${mm}-${dd}`;

            addModal.classList.remove('hidden');
            setTimeout(() => taskNameInput.focus(), 50);
        }

        function closeAddModal() {
            addModal.classList.add('hidden');
        }

        // Auto-capitalize first letter as user types
        taskNameInput.addEventListener('input', () => {
            const val = taskNameInput.value;
            if (val.length > 0 && val.charAt(0) !== val.charAt(0).toUpperCase()) {
                const start = taskNameInput.selectionStart;
                const end = taskNameInput.selectionEnd;
                taskNameInput.value = capitalizeFirst(val);
                taskNameInput.setSelectionRange(start, end);
            }
        });

        // Submit form on Enter key inside the 2-line Task Name box
        taskNameInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                addTaskletForm.requestSubmit();
            }
        });

        addTaskletForm.addEventListener('submit', (e) => {
            e.preventDefault();
            addModalError.classList.add('hidden');

            const rawName = taskNameInput.value.trim();
            const dateVal = deadlineDateInput.value;
            const timeVal = deadlineTimeInput.value;

            if (!rawName) {
                addModalErrorText.textContent = 'Please enter a Task Name.';
                addModalError.classList.remove('hidden');
                taskNameInput.focus();
                return;
            }

            if (!dateVal || !timeVal) {
                addModalErrorText.textContent = 'Both Deadline Date and Deadline Time are mandatory.';
                addModalError.classList.remove('hidden');
                return;
            }

            const [year, month, day] = dateVal.split('-').map(Number);
            const [hours, minutes] = timeVal.split(':').map(Number);
            const deadlineDateObj = new Date(year, month - 1, day, hours, minutes, 0, 0);

            if (isNaN(deadlineDateObj.getTime())) {
                addModalErrorText.textContent = 'Invalid date or time selected.';
                addModalError.classList.remove('hidden');
                return;
            }

            if (deadlineDateObj.getTime() <= Date.now()) {
                addModalErrorText.textContent = 'Deadline Date & Time cannot be in the past. Please choose a future time.';
                addModalError.classList.remove('hidden');
                return;
            }

            const maxSeq = state.tasklets.reduce((max, t) => Math.max(max, t.seq || 0), 0);
            const nextSeq = maxSeq + 1;
            const formattedTitle = capitalizeFirst(rawName);

            const newTasklet = {
                id: `tsk-${Date.now()}`,
                seq: nextSeq,
                title: formattedTitle,
                deadlineISO: deadlineDateObj.toISOString(),
                status: 'Active',
                description: '',
                resolvedAtISO: null,
                createdBy: (userProfile && userProfile.name ? userProfile.name : 'Director').trim(),
                createdAtISO: new Date().toISOString()
            };

            state.tasklets.unshift(newTasklet);
            state.activeFilter = 'Active';
            state.currentPage = 1;
            state.selectedId = newTasklet.id;
            state.rightPanelMode = 'tasklet';
            state.mobileView = 'list';
            state.showInlineWarning = false;

            syncTaskletToCloud(newTasklet);
            closeAddModal();
            renderAll();
            showToast(`Tasklet #${nextSeq} created.`);
        });

        openAddModalBtn.addEventListener('click', openAddModal);
        closeAddModalBtn.addEventListener('click', closeAddModal);
        cancelAddModalBtn.addEventListener('click', closeAddModal);

        // =========================================================================
        // SEARCH & PAGINATION CONTROLS
        // =========================================================================
        searchInput.addEventListener('input', () => {
            state.searchQuery = searchInput.value;
            state.currentPage = 1;
            clearSearchBtn.classList.toggle('hidden', !state.searchQuery);
            renderAll();
        });

        clearSearchBtn.addEventListener('click', () => {
            searchInput.value = '';
            state.searchQuery = '';
            state.currentPage = 1;
            clearSearchBtn.classList.add('hidden');
            renderAll();
        });

        prevPageBtn.addEventListener('click', () => {
            if (state.currentPage > 1) {
                state.currentPage--;
                renderTaskletList();
            }
        });

        nextPageBtn.addEventListener('click', () => {
            const totalPages = Math.max(1, Math.ceil(getFilteredTasklets().length / ITEMS_PER_PAGE));
            if (state.currentPage < totalPages) {
                state.currentPage++;
                renderTaskletList();
            }
        });

        // =========================================================================
        // INITIALIZATION & FIREBASE AUTH STATE OBSERVER
        // =========================================================================
        loadAllowedUsers();
        loadSession();
        loadFromStorage();
        updateUserProfileUI();

        const initialActive = getFilteredTasklets();
        if (initialActive.length > 0) {
            state.selectedId = initialActive[0].id;
        } else if (state.tasklets.length > 0) {
            const sorted = [...state.tasklets].sort((a, b) => b.seq - a.seq);
            state.selectedId = sorted[0].id;
        }
        renderAll();

        if (auth && hasValidFirebaseConfig && !isPreviewSandbox) {
            onAuthStateChanged(auth, (fbUser) => {
                if (fbUser && fbUser.email) {
                    attemptGoogleLogin(fbUser.email, fbUser.displayName || '', fbUser.photoURL || '');
                } else {
                    stopFirestoreSync();
                    userProfile = null;
                    saveSession();
                    updateUserProfileUI();
                }
            });
        }

        // Periodically re-evaluate overdue status every 30 seconds
        setInterval(() => {
            renderFilterTabs();
            renderTaskletList();
        }, 30000);
    </script>
</body>
</html>