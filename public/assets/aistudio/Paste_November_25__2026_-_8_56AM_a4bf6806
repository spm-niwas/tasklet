        // =========================================================================
        // FILTERING, SEARCH & PAGINATION
        // =========================================================================
        function getStatusCounts() {
            const counts = {
                All: state.tasklets.length,
                Overdue: 0,
                Active: 0,
                Abandoned: 0,
                Closed: 0
            };
            state.tasklets.forEach((t) => {
                const eff = getEffectiveStatus(t);
                if (counts[eff] !== undefined) {
                    counts[eff]++;
                }
            });
            return counts;
        }

        function getFilteredTasklets() {
            const tokens = state.searchQuery
                .trim()
                .toLowerCase()
                .split(/\s+/)
                .filter(Boolean);

            return state.tasklets
                .filter((t) => {
                    const eff = getEffectiveStatus(t);
                    if (state.activeFilter !== 'All' && eff !== state.activeFilter) {
                        return false;
                    }
                    if (tokens.length > 0) {
                        const searchableText = [
                            `#${t.seq}`,
                            String(t.seq),
                            t.title || '',
                            t.description || ''
                        ]
                            .join(' ')
                            .toLowerCase();

                        return tokens.every((token) => searchableText.includes(token));
                    }
                    return true;
                })
                .sort((a, b) => b.seq - a.seq);
        }

