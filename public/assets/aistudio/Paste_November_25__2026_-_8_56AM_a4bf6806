<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NIWAS Tasklet</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Load Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Hide horizontal scrollbar on mobile filter tabs while keeping touch swipe smooth */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        /* Support iOS/Android bottom safe-area insets */
        .pb-safe {
            padding-bottom: max(1rem, env(safe-area-inset-bottom));
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col antialiased selection:bg-emerald-600 selection:text-white overflow-x-hidden">

    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
        <div class="w-full px-3.5 sm:px-6 py-2.5 sm:py-3 flex flex-wrap items-center justify-between gap-2.5 sm:gap-3">
            <!-- Brand Title -->
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-emerald-600 flex items-center justify-center text-white shadow-sm shadow-emerald-600/20 shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-bold tracking-tight text-slate-900 leading-none">NIWAS Tasklet</h1>
                    <p class="text-[11px] font-medium text-slate-400 mt-0.5">Focused Deadline Workspace</p>
                </div>
            </div>

            <!-- Search Bar (16px on mobile prevents iOS Safari auto-zoom) -->
            <div class="order-3 md:order-2 w-full md:w-[28rem] lg:w-[36rem] xl:w-[42rem] relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </span>
                <input
                    id="search-input"
                    type="text"
                    placeholder="Search tasklets by keywords, description, or #number..."
                    class="w-full pl-10 pr-9 py-2 bg-slate-100/80 hover:bg-slate-100 focus:bg-white text-base sm:text-sm text-slate-800 placeholder-slate-400 rounded-xl border border-transparent focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition"
                >
                <button id="clear-search-btn" type="button" class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600" title="Clear search">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Action Controls: Add Tasklet & Settings Gear -->
            <div class="order-2 md:order-3 flex items-center gap-2">
                <!-- Primary Add Button -->
                <button
                    id="open-add-modal-btn"
                    type="button"
                    class="px-3.5 sm:px-4 py-2 sm:py-2.5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-xs sm:text-sm font-semibold rounded-xl shadow-sm shadow-emerald-600/20 transition flex items-center gap-1.5"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
                    </svg>
                    <span class="sm:hidden">Add</span>
                    <span class="hidden sm:inline">Add Tasklet</span>
                </button>

                <!-- Settings Gear Menu (Name, Gmail ID & Logout) -->
                <div class="relative" id="settings-menu-container">
                    <button
                        id="settings-gear-btn"
                        type="button"
                        title="Account Settings"
                        aria-label="Account Settings"
                        class="p-2.5 text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200/70 rounded-xl transition flex items-center justify-center"
                    >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </button>

                    <!-- Dropdown Card -->
                    <div
                        id="settings-dropdown"
                        class="hidden absolute right-0 mt-2 w-[calc(100vw-1.75rem)] max-w-xs sm:w-80 bg-white rounded-2xl border border-slate-200 shadow-xl py-4 px-4 z-50"
                    >
                        <!-- Google Profile Header: Avatar, Name, Email & Role -->
                        <div class="flex items-start gap-3 pb-3.5 border-b border-slate-100">
                            <div class="relative shrink-0">
                                <div id="user-avatar-badge" class="w-11 h-11 rounded-full bg-emerald-600 text-white font-bold text-sm flex items-center justify-center shadow-xs overflow-hidden">
                                    D
                                </div>
                                <!-- Google Profile Indicator Badge -->
                                <span class="absolute -bottom-0.5 -right-0.5 w-4 h-4 rounded-full bg-white shadow-xs border border-slate-200 flex items-center justify-center" title="Google Account">
                                    <svg class="w-2.5 h-2.5" viewBox="0 0 24 24">
                                        <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.11-6.72-4.96H1.29v3.14C3.26 21.3 7.31 24 12 24z"/>
                                        <path fill="#FBBC05" d="M5.28 14.24c-.24-.72-.38-1.49-.38-2.24s.14-1.52.38-2.24V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.99-3.14z"/>
                                        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.99 3.14c.95-2.85 3.6-4.96 6.72-4.96z"/>
                                    </svg>
                                </span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p id="user-display-name" class="text-sm font-bold text-slate-900 truncate">Director</p>
                                <p id="user-display-email" class="text-xs text-slate-500 truncate">director@spmniwas.in</p>
                                <p id="user-role-pill" class="text-xs font-normal text-slate-500 mt-1">Admin</p>
                            </div>
                        </div>

                        <div class="pt-2.5 flex flex-col gap-2">
                            <!-- Admin-Only Menu Items in One Row -->
                            <div id="admin-whitelist-section" class="hidden grid grid-cols-2 gap-1.5 pb-2 border-b border-slate-100">
                                <button
                                    id="toggle-add-user-btn"
                                    type="button"
                                    class="w-full px-2.5 py-2 rounded-xl justify-center text-slate-700 hover:bg-slate-100 hover:text-slate-900 text-xs font-medium transition flex items-center gap-1.5"
                                >
                                    <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                                    </svg>
                                    <span class="truncate">Add User</span>
                                </button>
                                <button
                                    id="toggle-clear-data-btn"
                                    type="button"
                                    class="w-full px-2.5 py-2 rounded-xl justify-center text-rose-600 hover:bg-rose-50 text-xs font-medium transition flex items-center gap-1.5"
                                >
                                    <svg class="w-4 h-4 text-rose-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                    <span class="truncate">Clear Data</span>
                                </button>
                            </div>

                            <!-- Logout Button at Bottom Right -->
                            <div class="flex justify-end">
                                <button
                                    id="logout-btn"
                                    type="button"
                                    class="px-3 py-2 rounded-xl text-rose-600 hover:bg-rose-50 text-xs font-medium transition flex items-center gap-1.5"
                                >
                                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                    </svg>
                                    <span>Logout</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Minimal Google Sign-In Screen (App Name + Login with Google Button Only) -->
    <div id="logged-out-screen" class="fixed inset-0 z-50 bg-slate-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xl w-full max-w-sm p-8 text-center space-y-6">
            <div class="flex flex-col items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-emerald-600 flex items-center justify-center text-white shadow-sm shadow-emerald-600/20">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">NIWAS Tasklet</h1>
            </div>

            <button
                id="google-signin-btn"
                type="button"
                class="w-full py-3 px-4 rounded-xl bg-white hover:bg-slate-50 active:bg-slate-100 border border-slate-300 text-slate-800 text-sm font-semibold shadow-xs transition flex items-center justify-center gap-3"
            >
                <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                    <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.11-6.72-4.96H1.29v3.14C3.26 21.3 7.31 24 12 24z"/>
                    <path fill="#FBBC05" d="M5.28 14.24c-.24-.72-.38-1.49-.38-2.24s.14-1.52.38-2.24V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.99-3.14z"/>
                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.99 3.14c.95-2.85 3.6-4.96 6.72-4.96z"/>
                </svg>
                <span>Login with Google</span>
            </button>

            <p id="login-error-msg" class="hidden text-xs font-medium text-rose-600 bg-rose-50 border border-rose-200 rounded-xl px-3 py-2.5"></p>
        </div>
    </div>

    <!-- Google Account Chooser Modal (Used when Firebase Google Popup runs locally or selects authorized accounts) -->
    <div id="google-chooser-modal" class="hidden fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xl w-full max-w-sm p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2.5">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.11-6.72-4.96H1.29v3.14C3.26 21.3 7.31 24 12 24z"/>
                        <path fill="#FBBC05" d="M5.28 14.24c-.24-.72-.38-1.49-.38-2.24s.14-1.52.38-2.24V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.99-3.14z"/>
                        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.99 3.14c.95-2.85 3.6-4.96 6.72-4.96z"/>
                    </svg>
                    <h3 class="text-sm font-bold text-slate-900">Choose a Google Account</h3>
                </div>
                <button id="close-chooser-btn" type="button" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div id="chooser-account-list" class="space-y-1.5">
                <!-- Quick-pick authorized accounts -->
            </div>
            <form id="custom-google-email-form" class="pt-2 border-t border-slate-100 space-y-2">
                <label for="google-email-verify-input" class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400">Or enter Google Email ID</label>
                <div class="flex gap-2">
                    <input
                        id="google-email-verify-input"
                        type="email"
                        required
                        placeholder="name@spmniwas.in"
                        class="flex-1 min-w-0 px-3 py-2 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-xs text-slate-900 outline-none"
                    >
                    <button type="submit" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition">
                        Continue
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Toast Notification Banner -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Floating Bottom-Left Role Switcher -->
    <div id="floating-role-switcher" class="fixed bottom-5 left-5 z-40 flex items-center gap-1 p-1.5 rounded-2xl bg-slate-900/95 backdrop-blur-md border border-slate-700/80 shadow-xl">
        <button
            id="floating-admin-view-btn"
            type="button"
            class="px-3 py-1.5 rounded-xl text-xs font-semibold transition bg-emerald-600 text-white shadow-xs"
        >
            Admin View
        </button>
        <button
            id="floating-user-view-btn"
            type="button"
            class="px-3 py-1.5 rounded-xl text-xs font-semibold transition text-slate-300 hover:text-white hover:bg-slate-800"
        >
            User View
        </button>
    </div>

    <!-- Main Two-Pane Split Workspace (45% Left / 55% Right on Desktop; Native Two-Screen Flow on Mobile) -->
    <main class="flex-1 w-full px-3 sm:px-6 py-3 sm:py-4 flex flex-col">
        <div class="flex-1 flex flex-col lg:flex-row gap-4 sm:gap-5 items-stretch">

            <!-- LEFT PANE (45% on desktop; full-screen List View on mobile) -->
            <section id="list-pane" class="w-full lg:w-[45%] bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col">
                <!-- 5 Status Filter Tabs with Live Count Badges (3 + 2 maximized grid on mobile, single row on sm+) -->
                <div class="p-2.5 sm:p-3 border-b border-slate-100 bg-slate-50/60 shrink-0">
                    <div id="filter-tabs" class="grid grid-cols-6 sm:flex sm:items-center gap-1.5 w-full">
                        <!-- Tabs rendered dynamically -->
                    </div>
                </div>

                <!-- Tasklet List (Auto-paginated at 25 per page) -->
                <div id="tasklet-list" class="flex-1 divide-y divide-slate-100 min-h-[360px] sm:min-h-[420px] flex flex-col overflow-y-auto">
                    <!-- Tasklet cards rendered dynamically -->
                </div>

                <!-- Pagination Footer (Automatically shown when items > 25) -->
                <div id="pagination-bar" class="hidden px-4 py-3 bg-slate-50/70 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600 shrink-0">
                    <span id="pagination-info" class="font-medium">Showing 0 of 0</span>
                    <div class="flex items-center gap-1.5">
                        <button id="prev-page-btn" type="button" class="px-3.5 py-2 sm:py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-40 disabled:pointer-events-none font-medium transition">
                            Prev
                        </button>
                        <span id="page-indicator" class="px-2 font-semibold text-slate-700">1 / 1</span>
                        <button id="next-page-btn" type="button" class="px-3.5 py-2 sm:py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-40 disabled:pointer-events-none font-medium transition">
                            Next
                        </button>
                    </div>
                </div>
            </section>

            <!-- RIGHT PANE (55% on desktop; full-screen Detail View on mobile) -->
            <section id="detail-pane" class="hidden lg:flex w-full lg:w-[55%] bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-7 min-h-[420px] sm:min-h-[460px] flex-col">
                <!-- Detail view rendered dynamically -->
            </section>

        </div>
    </main>

    <!-- ADD TASKLET MODAL -->
    <div id="add-modal" class="hidden fixed inset-0 z-40 bg-slate-900/50 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 overflow-y-auto">
        <div class="bg-white rounded-t-3xl sm:rounded-2xl border border-slate-200 shadow-xl w-full max-w-md overflow-hidden sm:my-auto max-h-[92dvh] overflow-y-auto pb-safe sm:pb-0">
            <div class="px-5 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between sticky top-0 bg-white z-10">
                <h2 class="text-base font-bold text-slate-900">Create New Tasklet</h2>
                <button id="close-add-modal-btn" type="button" class="p-2 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <form id="add-tasklet-form" class="p-5 sm:p-6 space-y-4" novalidate>
                <!-- Task Name -->
                <div>
                    <label for="task-name-input" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                        Task Name <span class="text-rose-500">*</span>
                    </label>
                    <textarea
                        id="task-name-input"
                        rows="2"
                        placeholder="e.g., Finalize quarterly architecture review"
                        class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-base sm:text-sm text-slate-900 outline-none transition resize-none leading-snug"
                        required
                    ></textarea>
                </div>

                <!-- Mandatory Deadline Date & Time -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label for="deadline-date-input" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                            Deadline Date <span class="text-rose-500">*</span>
                        </label>
                        <input
                            id="deadline-date-input"
                            type="date"
                            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-base sm:text-sm text-slate-900 outline-none transition"
                            required
                        >
                    </div>
                    <div>
                        <label for="deadline-time-input" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                            Deadline Time <span class="text-rose-500">*</span>
                        </label>
                        <input
                            id="deadline-time-input"
                            type="time"
                            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 text-base sm:text-sm text-slate-900 outline-none transition"
                            required
                        >
                    </div>
                </div>

                <!-- Inline Validation Error -->
                <div id="add-modal-error" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium flex items-start gap-2">
