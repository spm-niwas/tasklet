        }

        // Storage keys & constants
        const STORAGE_KEY = 'niwas_tasklet_data_v1';
        const ALLOWED_USERS_KEY = 'niwas_tasklet_allowed_users_v1';
        const SESSION_KEY = 'niwas_tasklet_session_v1';
        const HARDCODED_ADMIN_EMAIL = 'director@spmniwas.in';
        const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;
        const ITEMS_PER_PAGE = 25;
        const MIN_WORDS = 3;
        const MAX_WORDS = 50;

        // Application State
        let state = {
            tasklets: [],
            activeFilter: 'Active',
            searchQuery: '',
            currentPage: 1,
            selectedId: null,
            showInlineWarning: false,
            rightPanelMode: 'tasklet', // 'tasklet' | 'addUser' | 'clearData'
            mobileView: 'list' // 'list' | 'detail' (used below 1024px)
        };

        let saveDebounceTimer = null;
        let pendingConfirmCallback = null;
        let unsubscribeTasklets = null;
        let unsubscribeUsers = null;

        // DOM Elements
        const searchInput = document.getElementById('search-input');
        const clearSearchBtn = document.getElementById('clear-search-btn');
        const filterTabsEl = document.getElementById('filter-tabs');
        const listPaneEl = document.getElementById('list-pane');
