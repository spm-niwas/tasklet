        } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js";

        // =========================================================================
        // FIREBASE CONFIGURATION (niwas-pm Live Keys)
        // =========================================================================
        const USER_FIREBASE_CONFIG = {
            apiKey: "AIzaSyBggJ8HLnuL_AmO28L39A57fV_m04n-NzA",
            authDomain: "niwas-pm.firebaseapp.com",
            projectId: "niwas-pm",
            storageBucket: "niwas-pm.firebasestorage.app",
            messagingSenderId: "217295743479",
            appId: "1:217295743479:web:142510cdd7bcb3a31726f2"
