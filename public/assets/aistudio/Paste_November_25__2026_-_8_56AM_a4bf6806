                    title: 'Permanently Delete Tasklet Data?',
                    message: `This will permanently delete ${scopeLabel} from both local storage and cloud sync. This action cannot be undone.`,
                    confirmLabel: `Delete ${matches.length} Tasklet${matches.length > 1 ? 's' : ''}`,
                    variant: 'danger',
                    onConfirm: async () => {
                        const idsToDelete = new Set(matches.map((t) => t.id));
                        state.tasklets = state.tasklets.filter((t) => !idsToDelete.has(t.id));
