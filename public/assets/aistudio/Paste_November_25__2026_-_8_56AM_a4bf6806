        // =========================================================================
        // DATE, STATUS & WORD COUNT HELPERS
        // =========================================================================
        function isOverdue(tasklet) {
            if (tasklet.status !== 'Active') return false;
            return new Date(tasklet.deadlineISO).getTime() < Date.now();
        }

        function getEffectiveStatus(tasklet) {
            if (tasklet.status === 'Closed') return 'Closed';
            if (tasklet.status === 'Abandoned') return 'Abandoned';
            return isOverdue(tasklet) ? 'Overdue' : 'Active';
        }

        function formatDateDDMMYY(isoString) {
            if (!isoString) return '--';
            const d = new Date(isoString);
            if (isNaN(d.getTime())) return '--';
            const dd = String(d.getDate()).padStart(2, '0');
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const yy = String(d.getFullYear()).slice(-2);
            return `${dd}-${mm}-${yy}`;
        }

        function formatTimeHHMM(isoString) {
            if (!isoString) return '--:--';
            const d = new Date(isoString);
            if (isNaN(d.getTime())) return '--:--';
            const hh = String(d.getHours()).padStart(2, '0');
            const min = String(d.getMinutes()).padStart(2, '0');
            return `${hh}:${min}`;
        }

        function formatDeadline(isoString) {
            return `${formatDateDDMMYY(isoString)} at ${formatTimeHHMM(isoString)}`;
        }

        function countWords(text) {
            const trimmed = (text || '').trim();
            if (!trimmed) return 0;
            return trimmed.split(/\s+/).length;
        }

        function enforceWordLimit(text, maxWords) {
            const trimmedStart = text.replace(/^\s+/, '');
            if (!trimmedStart) return '';
            const words = trimmedStart.trim().split(/\s+/);
            if (words.length <= maxWords) return text;
            const matches = [...text.matchAll(/\S+/g)];
            if (matches.length > maxWords) {
                return text.slice(0, matches[maxWords].index).trimEnd();
            }
            return words.slice(0, maxWords).join(' ');
        }

        function escapeHTML(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function capitalizeFirst(str) {
            if (!str) return '';
            return str.charAt(0).toUpperCase() + str.slice(1);
        }

