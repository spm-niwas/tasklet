                const dateVal = dateInput.value;
                if (!dateVal) return [];
                const [y, m, d] = dateVal.split('-').map(Number);
                if (mode === 'before') {
                    const cutoffEnd = new Date(y, m - 1, d, 23, 59, 59, 999).getTime();
                    return state.tasklets.filter((t) => {
                        const ts = new Date(t.createdAtISO || t.deadlineISO).getTime();
                        return !isNaN(ts) && ts <= cutoffEnd;
                    });
                } else {
                    const cutoffStart = new Date(y, m - 1, d, 0, 0, 0, 0).getTime();
                    return state.tasklets.filter((t) => {
                        const ts = new Date(t.createdAtISO || t.deadlineISO).getTime();
                        return !isNaN(ts) && ts >= cutoffStart;
                    });
